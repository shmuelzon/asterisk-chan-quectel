#
# OpenWrt package for chan_quectel
#
# Generated by openwrt/make-feed.sh - edit that template, not the copy in the
# generated feed.
#
include $(TOPDIR)/rules.mk

PKG_NAME:=asterisk-chan-quectel
PKG_VERSION:=@PKG_VERSION@
PKG_RELEASE:=@PKG_RELEASE@

PKG_LICENSE:=GPL-2.0
PKG_LICENSE_FILES:=README.md
PKG_MAINTAINER:=Assaf Inbal
PKG_INSTALL:=1

PKG_BUILD_DIR:=$(BUILD_DIR)/$(PKG_NAME)-$(PKG_VERSION)

MODULES_DIR:=/usr/lib/asterisk/modules

include $(INCLUDE_DIR)/package.mk
include $(INCLUDE_DIR)/cmake.mk

# Build against the Asterisk headers this SDK staged, so the module's ABI
# matches the asterisk package it will be installed alongside.
CMAKE_OPTIONS += -DAST_HEADER_DIR=$(STAGING_DIR)/usr/include
# The bundled sources carry no .git, so CMake cannot run git describe. Pass the
# version make-feed.sh derived from the tag instead.
CMAKE_OPTIONS += -DCHAN_QUECTEL_VERSION=@VERSION_STRING@

define Package/asterisk-chan-quectel
  SUBMENU:=Telephony
  SECTION:=net
  CATEGORY:=Network
  URL:=https://github.com/shmuelzon/asterisk-chan-quectel
  # kmod-usb-serial-option provides the /dev/ttyUSB* AT port (and pulls in
  # kmod-usb-serial); kmod-usb-audio provides the UAC sound card the voice path
  # needs. Without either the driver installs but cannot find the modem.
  DEPENDS:=asterisk +alsa-lib +kmod-usb-serial-option +kmod-usb-audio
  TITLE:=Asterisk channel driver for the Quectel EC25-E
endef

define Package/asterisk-chan-quectel/description
  A small Asterisk channel driver for the Quectel EC25-E, carrying voice over
  the module's USB Audio Class interface and control/SMS over its AT serial
  port. Supports inbound and outbound calls, DTMF, caller id, and SMS in PDU
  mode including UCS-2 and concatenated messages.
endef

define Package/asterisk-chan-quectel/conffiles
/etc/asterisk/quectel.conf
endef

# Sources are bundled inside the package directory rather than downloaded.
define Build/Prepare
	mkdir -p $(PKG_BUILD_DIR)
	$(CP) ./src/. $(PKG_BUILD_DIR)/
endef

define Package/asterisk-chan-quectel/install
	$(INSTALL_DIR) $(1)/etc/asterisk
	$(INSTALL_DATA) $(PKG_INSTALL_DIR)/etc/asterisk/quectel.conf $(1)/etc/asterisk
	$(INSTALL_DIR) $(1)$(MODULES_DIR)
	$(INSTALL_BIN) $(PKG_INSTALL_DIR)$(MODULES_DIR)/chan_quectel.so $(1)$(MODULES_DIR)
endef

define Package/asterisk-chan-quectel/postinst
#!/bin/sh
if [ -z "$${IPKG_INSTROOT}" ]; then
  echo
  echo 'o-------------------------------------------------------------------o'
  echo '| asterisk-chan-quectel                                                |'
  echo 'o-------------------------------------------------------------------o'
  echo '| RESTART ASTERISK to pick this up:   service asterisk restart      |'
  echo '|                                                                   |'
  echo '| "module unload" + "module load" is NOT enough on musl: dlclose()  |'
  echo '| is a no-op there, so the previously loaded code keeps running     |'
  echo '| even though both commands report success.                         |'
  echo 'o-------------------------------------------------------------------o'
  echo '| The asterisk user must be in the "dialout" and "audio" groups to  |'
  echo '| reach /dev/ttyUSB* and the USB audio device.                      |'
  echo 'o-------------------------------------------------------------------o'
  echo '| Required kernel modules: kmod-usb-serial kmod-usb-serial-option   |'
  echo '|                          kmod-usb-audio                           |'
  echo 'o-------------------------------------------------------------------o'
  echo
fi
exit 0
endef

$(eval $(call BuildPackage,asterisk-chan-quectel))
